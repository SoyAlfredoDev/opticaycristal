# Servidor solamente. No subir credenciales ni usar NEXT_PUBLIC_.
WEBPAY_ENABLED=false
WEBPAY_ENVIRONMENT=integration
CLIENT_APP_URL=http://localhost:3049
# En integración, el SDK utiliza las credenciales públicas oficiales de prueba.
# En producción se requieren las credenciales propias de la óptica:
# WEBPAY_ENVIRONMENT=production
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# CLIENT_APP_URL=https://opticaycristal.cl
# La aplicación reutiliza CLIENT_DATA_KEY y CLIENT_DATABASE_* existentes.
