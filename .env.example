# Acceso del panel interno /admin. Usa una contraseña única de al menos 16 caracteres
# y genera SESSION_SECRET con un valor aleatorio de 32 bytes o más.
# Desactivar solo después de comprobar un administrador individual y recuperación.
ADMIN_LEGACY_LOGIN_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
# Segunda cuenta opcional del panel administrativo
ADMIN_USER_2=
ADMIN_PASSWORD_2=
SESSION_SECRET=una-cadena-aleatoria-de-al-menos-32-caracteres

# Los dos correos salen desde este buzón. El aviso interno también llega aquí.
MAIL_TO=contacto@opticaycristal.cl
MAIL_FROM=contacto@opticaycristal.cl

# Resend. El dominio opticaycristal.cl debe estar verificado en Resend.
RESEND_API_KEY=

# MySQL de cPanel. En el mismo servidor el host suele ser localhost.
# En producción configura MySQL para persistir formularios y pedidos.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Radar Comercial B2B: Neon PostgreSQL (no reutiliza las credenciales MySQL)
DATABASE_URL=
# Opcionales: endpoint compatible con OpenAI chat completions para interpretar criterios
RADAR_AI_API_KEY=
RADAR_AI_BASE_URL=
RADAR_AI_MODEL=
# Nominatim solo resuelve la comuna o región (consulta manual y limitada por su política)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
# Endpoint configurable para buscar elementos etiquetados en OpenStreetMap Overpass
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
SRE_API_TOKEN=token_publico

RESEND_WEBHOOK_SECRET=
RADAR_PUBLIC_URL=https://opticaycristal.cl
RADAR_MAIL_FROM=Óptica & Cristal <contacto@opticaycristal.cl>
RADAR_MAIL_REPLY_TO=contacto@opticaycristal.cl
RADAR_MAIL_COMPANY_ADDRESS=Huérfanos 713, local 18, Santiago Centro
RADAR_RESEND_TRACKING_READY=false
RADAR_MARKETING_ENABLED=false
RADAR_MAIL_DAILY_LIMIT=50
RADAR_INBOUND_DOMAIN=respuestas.opticaycristal.cl
RADAR_INBOUND_READY=false
RESEND_RECEIVING_API_KEY=
CRON_SECRET=
RADAR_AGENT_API_KEY=
RADAR_AGENT_SCOPES=read

# Programa de clientes (servidor; nunca NEXT_PUBLIC_)
# CLIENT_AUTH_SECRET: generar aleatoriamente mínimo32 caracteres
CLIENT_AUTH_SECRET=
# CLIENT_DATA_KEY: generar 32 bytes aleatorios en base64; conservar en gestor de secretos
CLIENT_DATA_KEY=
CLIENT_APP_URL=http://localhost:3000
CLIENT_DATABASE_SCHEMA=oc_customers_preview_20261028
# Opcional, reutiliza DATABASE_URL si no se define
CLIENT_DATABASE_URL=
CLIENT_DATABASE_URL_UNPOOLED=
# Opcional: usuarios internos existentes, separados por comas. No correos del registro público.
CLIENT_ADMIN_USERS=

# Felicitaciones por ascenso: desarrollo siempre captura sin envío real.
# Activar únicamente tras aplicar sql/clients/018-level-upgrade-mail.sql en producción.
CLIENT_LEVEL_MAIL_ENABLED=false
# public por defecto; mantener web y clientes en la misma base para avisos.
WEBSITE_DATABASE_SCHEMA=public

# Verificacion de clientes por mensaje entrante Kapso; activar con receptor conectado.
WHATSAPP_VERIFICATION_ENABLED=false
KAPSO_PHONE_NUMBER_ID=1368248166370894
KAPSO_WEBHOOK_SECRET=

# Consultas personales antiguas: transición temporal, desactivadas por defecto.
WHATSAPP_LEGACY_PERSONAL_ENABLED=false
# El contrato firmado de Cris reemplaza las consultas personales antiguas.
CRIS_API_ENABLED=false
# JSON array provisioned privately in server environment. Never paste real values in docs.
# Each entry: id, tokenHash (SHA-256), scopes, optional senderSigningSecret.
CRIS_API_KEYS_JSON=[]

# Encuestas de satisfacción: activar solo tras migración 024 y revisión.
CLIENT_SURVEYS_ENABLED=false

# WhatsApp saliente: plantilla AUTHENTICATION aprobada y API key solo de servidor.
# No confundir con las credenciales de consulta privada de Cris.
WHATSAPP_OTP_ENABLED=false
KAPSO_API_KEY=
KAPSO_OTP_TEMPLATE_NAME=oc_verificacion_whatsapp_v1
KAPSO_OTP_TEMPLATE_LANGUAGE=es_CL
